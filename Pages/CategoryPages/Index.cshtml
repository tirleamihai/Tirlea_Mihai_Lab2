@page "{id:int?}"
@model Tirlea_Mihai_Lab2.Pages.CategoryPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Category[0].CategoryName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category[0].BookCategories)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.BookCategoryData.Books != null)
        {
            <h3>Books Edited by Selected Publisher </h3>
            <table class="table">

            @foreach (var item in Model.BookCategoryData.BookCategories)
            {
                string selectedRow = "";
                if (item.ID == Model.BookCategoryID)
                {
                    selectedRow = "table-success";
                }
                <tr class=" @selectedRow ">
                    <td>
                        @Html.DisplayFor(model => item.Category)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Books)
                    </td>
                    <td>
                        <a asp-page="./Index" asp-route-id="@item.ID">Select</a>|
                        <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                        <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                        <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                    </td>
                </tr>
            }
            
            </table>
        }